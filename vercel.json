{
    "version": 2,
    "builds": [
        {
            "src": "backend/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/frontend/assets/$1"
        },
        {
            "src": "/(.*\\.css)",
            "dest": "/frontend/$1"
        },
        {
            "src": "/(.*\\.js)",
            "dest": "/frontend/$1"
        },
        {
            "src": "/api/(.*)",
            "dest": "/backend/server.js"
        },
        {
            "src": "/dashboard",
            "dest": "/frontend/dashboard.html"
        },
        {
            "src": "/onboarding",
            "dest": "/frontend/onboarding.html"
        },
        {
            "src": "/roadmap-detail",
            "dest": "/frontend/roadmap-detail.html"
        },
        {
            "src": "/",
            "dest": "/frontend/index.html"
        }
    ]
}