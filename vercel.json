{
    "version": 2,
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.js"
        },
        {
            "src": "/dashboard",
            "dest": "/frontend/dashboard.html"
        },
        {
            "src": "/onboarding",
            "dest": "/frontend/onboarding.html"
        },
        {
            "src": "/roadmap-detail",
            "dest": "/frontend/roadmap-detail.html"
        },
        {
            "src": "/login",
            "dest": "/frontend/login.html"
        },
        {
            "src": "/register",
            "dest": "/frontend/register.html"
        },
        {
            "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|mp4|mp3|webm|ogg|wav|mov))",
            "dest": "/frontend/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/index.html"
        }
    ]
}