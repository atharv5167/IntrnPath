{
    "outputDirectory": "frontend",
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/dashboard",
            "destination": "/dashboard.html"
        },
        {
            "source": "/onboarding",
            "destination": "/onboarding.html"
        },
        {
            "source": "/roadmap-detail",
            "destination": "/roadmap-detail.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}